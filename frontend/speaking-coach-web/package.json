{
  "name": "speaking-coach-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint:install": "npm ci --prefix lint",
    "lint": "node lint/node_modules/eslint/bin/eslint.js \"src/**/*.{ts,tsx}\"",
    "catalog": "node --experimental-strip-types --no-warnings scripts/learn-catalog.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/browser": "^11.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
