<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit testlar: asosan "toza" mantiq; servislar (masalan, MockExamService) xotiradagi baza
       (EF InMemory) bilan tekshiriladi, Gemini'ga murojaat qilinmaydi — shuning uchun tez, internet va
       Postgres'siz ishlaydi, CI'da ham. Ishga tushirish:
         dotnet test backend/SpeakingCoach.Api.Tests
       Paket versiyalari "*" bilan: shu qatordagi eng so'nggi patch olinadi. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.*" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="SpeakingCoach.Domain.Entities" />
    <Using Include="SpeakingCoach.Domain.Rules" />
    <Using Include="SpeakingCoach.Application" />
    <Using Include="SpeakingCoach.Application.Abstractions" />
    <Using Include="SpeakingCoach.Application.Content" />
    <Using Include="SpeakingCoach.Application.Mock" />
    <Using Include="SpeakingCoach.Application.Telegram" />
    <Using Include="SpeakingCoach.Infrastructure" />
    <Using Include="SpeakingCoach.Infrastructure.Persistence" />
    <Using Include="SpeakingCoach.Infrastructure.Ai" />
    <Using Include="SpeakingCoach.Infrastructure.Identity" />
    <Using Include="SpeakingCoach.Infrastructure.Telegram" />
    <Using Include="SpeakingCoach.Infrastructure.Jobs" />
    <Using Include="SpeakingCoach.Api.Web" />
    <Using Include="SpeakingCoach.Api.Endpoints" />
    <ProjectReference Include="..\SpeakingCoach.Api\SpeakingCoach.Api.csproj" />
  </ItemGroup>

</Project>
