<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit testlar: faqat "toza" mantiq (bazaga va Gemini'ga murojaat
       qilmaydigan kod) tekshiriladi — shuning uchun tez, internet va
       ma'lumotlar bazasisiz ishlaydi, CI'da ham. Ishga tushirish:
         dotnet test backend/SpeakingCoach.Api.Tests
       Paket versiyalari "*" bilan: shu qatordagi eng so'nggi patch olinadi. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.*" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\SpeakingCoach.Api\SpeakingCoach.Api.csproj" />
  </ItemGroup>

</Project>
